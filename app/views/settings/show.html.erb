<div class="card">
  <h1>Settings</h1>
  <%= form_with url: settings_path, method: :patch, local: true do |f| %>
    <div style="margin-bottom: 20px;">
      <label for="gitlab_username" style="display: block; margin-bottom: 8px; font-weight: 600; color: #374151;">
        GitLab Username
      </label>
      <input
        type="text"
        id="gitlab_username"
        name="gitlab_username"
        value="<%= @gitlab_username %>"
        placeholder="e.g., john.doe"
        style="width: 100%; max-width: 400px; padding: 10px; border: 1px solid #d1d5db; border-radius: 4px; font-size: 14px;"
      />
      <p style="margin-top: 8px; color: #6b7280; font-size: 14px;">
        Your comments will be highlighted when viewing merge request feedback.
      </p>
    </div>
    <div style="display: flex; gap: 12px;">
      <button type="submit" class="btn">
        Save Settings
      </button>
      <a href="<%= exports_path %>" style="padding: 10px 20px; text-decoration: none; color: #6b7280;">
        Cancel
      </a>
    </div>
  <% end %>
</div>
<% if notice %>
  <div style="margin-top: 20px; padding: 12px 16px; background: #dcfce7; color: #166534; border-radius: 4px; border-left: 4px solid #22c55e;">
    <%= notice %>
  </div>
<% end %>
