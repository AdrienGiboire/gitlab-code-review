<div class="card">
  <h1><%= @export.mr_title %></h1>
  <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; margin-bottom: 24px; color: #6b7280;">
    <strong>Project:</strong> <code><%= @export.project_path %></code>
    <strong>MR:</strong> <span>#<%= @export.mr_iid %></span>
    <strong>Author:</strong> <span><%= @export.mr_author %></span>
    <strong>State:</strong> <span style="padding: 4px 8px; border-radius: 4px; background: <%= @export.mr_state == 'opened' ? '#dcfce7' : '#f3f4f6' %>; color: <%= @export.mr_state == 'opened' ? '#166534' : '#374151' %>;"><%= @export.mr_state %></span>
    <strong>URL:</strong> <a href="<%= @export.mr_url %>" target="_blank"><%= @export.mr_url %></a>
    <strong>Exported:</strong> <span><%= @export.created_at.strftime('%Y-%m-%d %H:%M') %></span>
  </div>
</div>
<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2 style="margin: 0;">Feedback (<span id="feedback-count"><%= @export.data.dig('feedback')&.length || 0 %></span> comments)</h2>
    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
      <input type="checkbox" id="hide-reviewed" onchange="toggleReviewed()">
      <span>Hide reviewed</span>
    </label>
  </div>
<% feedback = @export.data.dig('feedback') || [] %>
<% reviewed_ids = @export.feedbacks.reviewed.pluck(:feedback_id) %>
<% grouped_feedback = feedback.group_by { |item| item['discussion_id'] } %>
  <% if feedback.any? %>
    <% grouped_feedback.each do |discussion_id, thread_items| %>
      <% thread_items.compact! %>
      <% next if thread_items.empty? %>
      <% is_multi_comment = thread_items.length > 1 %>
      <% thread_all_reviewed = thread_items.all? { |item| reviewed_ids.include?(item['id'].to_s) } %>
      <div class="thread-container" data-discussion-id="<%= discussion_id %>" data-reviewed="<%= thread_all_reviewed %>" style="margin-bottom: 24px; <%= is_multi_comment ? 'border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; background: #fafafa;' : '' %>">
        <% if is_multi_comment %>
          <div onclick="toggleThread(this.closest('.thread-container'))" style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-size: 14px; font-weight: 600; cursor: pointer; user-select: none; display: flex; align-items: center; gap: 8px;">
            <span class="thread-toggle">▼</span>
            <span>💬 Thread (<%= thread_items.length %> comments)</span>
          </div>
        <% end %>
        <div class="thread-content">
        <% thread_items.each_with_index do |item, index| %>
          <% next unless item['id'] %>
          <% is_reviewed = reviewed_ids.include?(item['id'].to_s) %>
          <% is_reply = is_multi_comment && index > 0 %>
          <% is_own_comment = @gitlab_username.present? && item['author'] == @gitlab_username %>
          <div class="feedback-item" data-reviewed="<%= is_reviewed %>" style="padding: 16px; border-left: 3px solid <%= is_reviewed ? '#22c55e' : (is_own_comment ? '#f59e0b' : '#2563eb') %>; background: <%= is_reviewed ? '#f0fdf4' : (is_own_comment ? '#fffbeb' : '#ffffff') %>; margin-bottom: <%= is_multi_comment ? '12px' : '16px' %>; border-radius: 4px; <%= is_reply ? 'margin-left: 24px;' : '' %>">
            <div style="margin-bottom: 8px; color: #6b7280; font-size: 14px; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong style="color: <%= is_own_comment ? '#d97706' : '#1f2937' %>;"><%= item['author'] %></strong>
                <% if is_own_comment %>
                  <span style="color: #f59e0b; font-size: 12px; margin-left: 4px;">(You)</span>
                <% end %>
                <% if item['web_url'] %>
                  • <a href="<%= item['web_url'] %>" target="_blank" style="color: #6b7280; text-decoration: none; font-size: 12px;">View in GitLab ↗</a>
                <% end %>
                <% if item['file'] && !is_reply %>
                  • <code style="background: #e5e7eb;"><%= item['file'] %><% if item['line'] %>:<%= item['line'] %><% end %></code>
                  <button onclick="navigator.clipboard.writeText('<%= item['file'] %>'); this.textContent='Copied!'; setTimeout(()=>this.textContent='Copy Path', 2000)" style="border: none; background: none; color: #6b7280; cursor: pointer; padding: 2px 6px; font-size: 12px; text-decoration: underline; margin-left: 6px;">Copy Path</button>
                <% elsif !item['file'] && !is_reply %>
                  • <span style="font-style: italic;">General comment</span>
                <% end %>
                <% if is_reviewed %>
                  • <span style="color: #22c55e; font-weight: 600;">✓ Reviewed</span>
                <% end %>
              </div>
              <% unless is_reviewed %>
                <button onclick="markReviewed(<%= item['id'] %>, this.closest('div').closest('div'))" class="btn" style="padding: 6px 12px; font-size: 14px;">
                  Mark Reviewed
                </button>
              <% end %>
            </div>
            <div style="white-space: pre-wrap; color: #374151;"><%= item['body'] %></div>
          </div>
        <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p style="text-align: center; color: #6b7280; margin: 40px 0;">No feedback found.</p>
  <% end %>
</div>
<p style="margin-top: 20px;"><a href="<%= exports_path %>">← Back to exports</a></p>
<script>
function markReviewed(feedbackId, element) {
  const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
  fetch('<%= mark_reviewed_export_feedback_path(@export, ':id') %>'.replace(':id', feedbackId), {
    method: 'PATCH',
    headers: {
      'X-CSRF-Token': csrfToken,
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    element.style.borderLeftColor = '#22c55e';
    element.style.background = '#f0fdf4';
    element.dataset.reviewed = 'true';
    const authorDiv = element.querySelector('div > div');
    const reviewedSpan = document.createElement('span');
    reviewedSpan.style.color = '#22c55e';
    reviewedSpan.style.fontWeight = '600';
    reviewedSpan.textContent = ' • ✓ Reviewed';
    authorDiv.appendChild(reviewedSpan);
    const button = element.querySelector('button.btn');
    if (button) button.remove();
    updateFeedbackCount();
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Failed to mark as reviewed');
  });
}
function toggleReviewed() {
  const hideReviewed = document.getElementById('hide-reviewed').checked;
  const threads = document.querySelectorAll('.thread-container');
  threads.forEach(thread => {
    const items = thread.querySelectorAll('.feedback-item');
    let hasVisibleItems = false;
    items.forEach(item => {
      if (hideReviewed && item.dataset.reviewed === 'true') {
        item.style.display = 'none';
      } else {
        item.style.display = 'block';
        hasVisibleItems = true;
      }
    });
    thread.style.display = hasVisibleItems ? 'block' : 'none';
  });
  updateFeedbackCount();
}
function updateFeedbackCount() {
  const hideReviewed = document.getElementById('hide-reviewed').checked;
  const threads = document.querySelectorAll('.thread-container');
  let count = 0;
  threads.forEach(thread => {
    if (thread.style.display !== 'none') {
      const items = thread.querySelectorAll('.feedback-item');
      items.forEach(item => {
        if (item.style.display !== 'none') {
          count++;
        }
      });
    }
  });
  document.getElementById('feedback-count').textContent = count;
}
function toggleThread(threadContainer) {
  const content = threadContainer.querySelector('.thread-content');
  const toggle = threadContainer.querySelector('.thread-toggle');
  if (content.style.display === 'none') {
    content.style.display = 'block';
    toggle.textContent = '▼';
  } else {
    content.style.display = 'none';
    toggle.textContent = '▶';
  }
}
</script>
