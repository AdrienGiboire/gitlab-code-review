grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/EngagementLetterTemplateTranslationDialog.vue\",\"line\":76,\"has_check_mark\":true},{\"id\":59150,\"author\":\"david\",\"body\":\"since we're adopting vuelidade, any personal motif for it not to be used here?\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/EngagementLetterTemplateTranslationDialog.vue\",\"line\":215,\"has_check_mark\":true},{\"id\":59151,\"author\":\"david\",\"body\":\"another wave of reviews :hugging:\",\"file\":null,\"line\":null,\"has_check_mark\":false},{\"id\":59153,\"author\":\"david\",\"body\":\"vuelidate instead?\",\"file\":\"app/javascript/packs/components/Shared/Templates/TemplateDialog.vue\",\"line\":258,\"has_check_mark\":true},{\"id\":59154,\"author\":\"david\",\"body\":\"we should always be aware that $refs[prop] might be null\",\"file\":\"app/javascript/packs/components/Shared/Templates/TemplateDialog.vue\",\"line\":282,\"has_check_mark\":true},{\"id\":59155,\"author\":\"david\",\"body\":\"I think there is an utility for this\",\"file\":\"app/javascript/packs/components/Shared/Templates/TemplateVariableHelper.vue\",\"line\":197,\"has_check_mark\":true},{\"id\":59156,\"author\":\"david\",\"body\":\"is this the one used in settings? if so, should be in settings namespace right?\",\"file\":\"app/javascript/packs/store/engagement-letter-template/index.js\",\"line\":null,\"has_check_mark\":true},{\"id\":59691,\"author\":\"adrien\",\"body\":\"I don't know.\\n\\nIt's a feature store that happens to be managed through Settings UI, but the data itself isn't \\\"settings\\\". Similar to how legal-case store isn't in a specific UI namespace.\",\"file\":\"app/javascript/packs/store/engagement-letter-template/index.js\",\"line\":null,\"has_check_mark\":false},{\"id\":59157,\"author\":\"david\",\"body\":\"no action needed, why not using same strategy on both? :grin:\",\"file\":\"app/javascript/packs/store/engagement-letter-template/index.js\",\"line\":30,\"has_check_mark\":true},{\"id\":59692,\"author\":\"adrien\",\"body\":\"I am not sure I get that one. Can you explain what you mean?\",\"file\":\"app/javascript/packs/store/engagement-letter-template/index.js\",\"line\":30,\"has_check_mark\":false},{\"id\":59158,\"author\":\"david\",\"body\":\"no action needed.\\n\\nIsn't more readable if \\n\\n```suggestion:-9+0\\n  return axiosRequest.get('/engagement_letter_templates', { params }).\\n    then(({ data }) =\\u003e {\\n      commit('setEngagementLetterTemplates', data)\\n      return data\\n    }).\\n    catch(error =\\u003e handleError(error)).\\n    finally(() =\\u003e commit('setLoading', false))\\n}\\n```\\n\\nI don't think you need to throw error, since if you subscribe to this action, you can catch it in the component still.\",\"file\":\"app/javascript/packs/store/engagement-letter-template/index.js\",\"line\":77,\"has_check_mark\":true},{\"id\":59159,\"author\":\"david\",\"body\":\"please try to keep the namespace definitions at the top after imports as most of the store modules, for easier reading by finding it already in the expected spot.\",\"file\":\"app/javascript/packs/store/shared-templates/index.js\",\"line\":14,\"has_check_mark\":true},{\"id\":59160,\"author\":\"david\",\"body\":\"since we're safe guarding against undefined, should we check also if it is an array?\",\"file\":\"app/javascript/packs/store/shared-templates/mutations.js\",\"line\":11,\"has_check_mark\":true},{\"id\":59161,\"author\":\"david\",\"body\":\"that's why we don't export default the store and make it two objects, so we can have all the module imports as \\n\\n`import { \\u003cNAMESPACE\\u003e, module } from ...`\",\"file\":\"app/javascript/packs/store/index.js\",\"line\":22,\"has_check_mark\":true},{\"id\":59162,\"author\":\"david\",\"body\":\"that's why we don't export default the store and make it two objects, so we can have all the module imports as \\n\\n`import { \\u003cNAMESPACE\\u003e, module } from ...`\",\"file\":\"app/javascript/packs/store/index.js\",\"line\":40,\"has_check_mark\":true},{\"id\":59163,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/views/settings/EngagementLetterTemplateDataList.vue\",\"line\":188,\"has_check_mark\":false},{\"id\":59164,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/views/settings/EngagementLetterTemplateDataListWorking.vue\",\"line\":154,\"has_check_mark\":true},{\"id\":59165,\"author\":\"david\",\"body\":\"shouldn't this import be made in the `setup()` ?\",\"file\":\"app/javascript/packs/views/settings/EngagementLetterTemplateDataListWorking.vue\",\"line\":255,\"has_check_mark\":false},{\"id\":59166,\"author\":\"david\",\"body\":\"can we guarantee that in all the instances, the foreign_key has this name? `fk_rails_1eab6264fb`\",\"file\":\"db/migrate/20250918140933_fix_engagement_letter_template_foreign_key.rb\",\"line\":4,\"has_check_mark\":true},{\"id\":59167,\"author\":\"david\",\"body\":\"I think this is the last wave :grin:\",\"file\":null,\"line\":null,\"has_check_mark\":false}]}"], ["created_at", "2025-11-06 15:20:38.913980"], ["updated_at", "2025-11-06 15:20:38.913980"], ["reviewed", false]]
