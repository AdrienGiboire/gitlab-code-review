b\",\"line\":null},{\"author\":\"david\",\"body\":\"this controller is bypassing the permissions system.\",\"file\":\"app/controllers/engagement_letter_templates_controller.rb\",\"line\":null},{\"author\":\"david\",\"body\":\"any reason for this? can't we make a conversion task/migration that would take care of old definitions on feature deploy?\",\"file\":\"app/controllers/legal_cases_controller.rb\",\"line\":146},{\"author\":\"david\",\"body\":\"wouldn't be more readable if it was a computed like\\n`showOrganizationWarning` ? just an opinion, no action needed.\",\"file\":\"app/javascript/packs/components/LegalCase/Editor/LegalCaseEditorEngagementLetter.vue\",\"line\":44},{\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\",\"file\":\"app/javascript/packs/components/LegalCase/Editor/LegalCaseEditorEngagementLetter.vue\",\"line\":206},{\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/DeleteEngagementLetterTemplateDialog.vue\",\"line\":48},{\"author\":\"david\",\"body\":\"instead of this, why don't we use the error catch we have in the ApplicationController, and use the utility method `parseErrorResponseMessage` ?\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/DeleteEngagementLetterTemplateDialog.vue\",\"line\":115},{\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/DeleteEngagementLetterTemplateTranslationDialog.vue\",\"line\":49},{\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\