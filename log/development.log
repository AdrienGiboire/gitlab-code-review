  [1m[36mTRANSACTION (0.3ms)[0m  [1m[35mBEGIN[0m
  ↳ app/controllers/exports_controller.rb:32:in `create'
  [1m[36mExport Create (2.7ms)[0m  [1m[32mINSERT INTO "exports" ("mr_url", "mr_iid", "project_path", "mr_title", "mr_author", "mr_state", "data", "created_at", "updated_at") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["mr_url", "https://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/merge_requests/1527"], ["mr_iid", 1527], ["project_path", "ILL/lawlabplatform"], ["mr_title", "Draft: feat: engagement letters templates and translations"], ["mr_author", "adrien"], ["mr_state", "opened"], ["data", "{\"project_path\":\"ILL/lawlabplatform\",\"mr_iid\":1527,\"merge_request\":{\"id\":1527,\"title\":\"Draft: feat: engagement letters templates and translations\",\"author\":\"adrien\",\"source_branch\":\"1485-categorize-engagement-letter\",\"target_branch\":\"alpha\",\"state\":\"opened\",\"web_url\":\"https://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/merge_requests/1527\"},\"feedback\":[{\"id\":59109,\"author\":\"david\",\"body\":\"be aware that the actions should always get the \\n- consumer user\\n- request params\\n\\nI placed as a rule the params require/permit to be in the actions, \\nsince they behave as a middle point between a controller method and the service\\n\\ncontroller method =\\u003e action =\\u003e service\\n\\nalways open minded about different ideas\",\"file\":\"app/actions/engagement_letter_template/create.rb\",\"line\":43},{\"id\":59110,\"author\":\"david\",\"body\":\"we use category to group actions, please make it more user friendly\",\"file\":\"app/actions/engagement_letter_template/base.rb\",\"line\":9},{\"id\":59111,\"author\":\"david\",\"body\":\"no need true, since destroy! explodes or returns true\",\"file\":\"app/actions/engagement_letter_template/destroy.rb\",\"line\":53},{\"id\":59112,\"author\":\"david\",\"body\":\"since we have almost all the catches for Active record errors, we should `update!`\",\"file\":\"app/actions/engagement_letter_template/update.rb\",\"line\":49},{\"id\":59113,\"author\":\"david\",\"body\":\"no need since base already does this\",\"file\":\"app/actions/public/engagement_letter/base.rb\",\"line\":36},{\"id\":59114,\"author\":\"david\",\"body\":\"if default value is `true` no need to implement this function\",\"file\":\"app/actions/public/engagement_letter/base.rb\",\"line\":12},{\"id\":59115,\"author\":\"david\",\"body\":\"question!\\n\\nsince is independent from any team, should we make it a platform permission, or we create a new namespace called `public` where we place all the publicly available actions?\",\"file\":\"app/actions/public/engagement_letter/base.rb\",\"line\":28},{\"id\":59689,\"author\":\"adrien\",\"body\":\"huh... good question. I am more keen to go with a `Public` namespace as I feel like it would break the meaning of `Platform` actions since that's not an actual platform action. What do you think?\",\"file\":\"app/actions/public/engagement_letter/base.rb\",\"line\":28},{\"id\":59116,\"author\":\"david\",\"body\":\"base already does this\",\"file\":\"app/actions/public/engagement_letter/session.rb\",\"line\":16},{\"id\":59117,\"author\":\"david\",\"body\":\"base does this\",\"file\":\"app/actions/public/engagement_letter/update.rb\",\"line\":16},{\"id\":59118,\"author\":\"david\",\"body\":\"why not instead of using an extra proc to assign a variable we do \\n\\n```suggestion:-5+0\\n  def send_letter\\n    render status: :ok, json: ActionDispatcher.\\n      with_user(current_user).\\n      dispatch(Action::LegalCase::EngagementLetter::Send, [params])\\n```\",\"file\":\"app/controllers/legal_cases/engagement_letters_controller.rb\",\"line\":9},{\"id\":59119,\"author\":\"david\",\"body\":\"when we do API based endpoints, we should use `with_api_key`\\n\\n```suggestion:-7+0\\nclass Public::EngagementLettersController \\u003c ActionController::API\\n  def session\\n    result = ActionDispatcher.\\n      with_api_key('\\u003cwhatever_you_think_you_need___or_nil\\u003e').\\n      dispatch(Action::Public::EngagementLetter::Session, [params])\\n\\n    render status: :ok, json: result\\n  end\\n```\",\"file\":\"app/controllers/public/engagement_letters_controller.rb\",\"line\":10},{\"id\":59120,\"author\":\"david\",\"body\":\"so far, but important changes that are needed while I finish the rest of the CR\",\"file\":null,\"line\":null},{\"id\":59139,\"author\":\"david\",\"body\":\"this controller is bypassing the permissions system.\",\"file\":\"app/controllers/engagement_letter_template_translations_controller.rb\",\"line\":null},{\"id\":59140,\"author\":\"david\",\"body\":\"this controller is bypassing the permissions system.\",\"file\":\"app/controllers/engagement_letter_templates_controller.rb\",\"line\":null},{\"id\":59141,\"author\":\"david\",\"body\":\"any reason for this? can't we make a conversion task/migration that would take care of old definitions on feature deploy?\",\"file\":\"app/controllers/legal_cases_controller.rb\",\"line\":146},{\"id\":59142,\"author\":\"david\",\"body\":\"wouldn't be more readable if it was a computed like\\n`showOrganizationWarning` ? just an opinion, no action needed.\",\"file\":\"app/javascript/packs/components/LegalCase/Editor/LegalCaseEditorEngagementLetter.vue\",\"line\":44},{\"id\":59690,\"author\":\"adrien\",\"body\":\"prolly, i usually limit myself to up to 2 conditions before using computed properties. no hard opinion on this.\",\"file\":\"app/javascript/packs/components/LegalCase/Editor/LegalCaseEditorEngagementLetter.vue\",\"line\":44},{\"id\":59143,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\",\"file\":\"app/javascript/packs/components/LegalCase/Editor/LegalCaseEditorEngagementLetter.vue\",\"line\":206},{\"id\":59144,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/DeleteEngagementLetterTemplateDialog.vue\",\"line\":48},{\"id\":59145,\"author\":\"david\",\"body\":\"instead of this, why don't we use the error catch we have in the ApplicationController, and use the utility method `parseErrorResponseMessage` ?\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/DeleteEngagementLetterTemplateDialog.vue\",\"line\":115},{\"id\":59146,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/DeleteEngagementLetterTemplateTranslationDialog.vue\",\"line\":49},{\"id\":59147,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/EngagementLetterTemplateDialog.vue\",\"line\":70},{\"id\":59148,\"author\":\"david\",\"body\":\"the way refs work, we should always verify if the ref was successful.\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/EngagementLetterTemplateEditor.vue\",\"line\":91},{\"id\":59149,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/EngagementLetterTemplateTranslationDialog.vue\",\"line\":76},{\"id\":59150,\"author\":\"david\",\"body\":\"since we're adopting vuelidade, any personal motif for it not to be used here?\",\"file\":\"app/javascript/packs/components/Settings/Tools/EngagementLetters/Templates/EngagementLetterTemplateTranslationDialog.vue\",\"line\":215},{\"id\":59151,\"author\":\"david\",\"body\":\"another wave of reviews :hugging:\",\"file\":null,\"line\":null},{\"id\":59153,\"author\":\"david\",\"body\":\"vuelidate instead?\",\"file\":\"app/javascript/packs/components/Shared/Templates/TemplateDialog.vue\",\"line\":258},{\"id\":59154,\"author\":\"david\",\"body\":\"we should always be aware that $refs[prop] might be null\",\"file\":\"app/javascript/packs/components/Shared/Templates/TemplateDialog.vue\",\"line\":282},{\"id\":59155,\"author\":\"david\",\"body\":\"I think there is an utility for this\",\"file\":\"app/javascript/packs/components/Shared/Templates/TemplateVariableHelper.vue\",\"line\":197},{\"id\":59156,\"author\":\"david\",\"body\":\"is this the one used in settings? if so, should be in settings namespace right?\",\"file\":\"app/javascript/packs/store/engagement-letter-template/index.js\",\"line\":null},{\"id\":59157,\"author\":\"david\",\"body\":\"no action needed, why not using same strategy on both? :grin:\",\"file\":\"app/javascript/packs/store/engagement-letter-template/index.js\",\"line\":30},{\"id\":59158,\"author\":\"david\",\"body\":\"no action needed.\\n\\nIsn't more readable if \\n\\n```suggestion:-9+0\\n  return axiosRequest.get('/engagement_letter_templates', { params }).\\n    then(({ data }) =\\u003e {\\n      commit('setEngagementLetterTemplates', data)\\n      return data\\n    }).\\n    catch(error =\\u003e handleError(error)).\\n    finally(() =\\u003e commit('setLoading', false))\\n}\\n```\\n\\nI don't think you need to throw error, since if you subscribe to this action, you can catch it in the component still.\",\"file\":\"app/javascript/packs/store/engagement-letter-template/index.js\",\"line\":77},{\"id\":59159,\"author\":\"david\",\"body\":\"please try to keep the namespace definitions at the top after imports as most of the store modules, for easier reading by finding it already in the expected spot.\",\"file\":\"app/javascript/packs/store/shared-templates/index.js\",\"line\":14},{\"id\":59160,\"author\":\"david\",\"body\":\"since we're safe guarding against undefined, should we check also if it is an array?\",\"file\":\"app/javascript/packs/store/shared-templates/mutations.js\",\"line\":11},{\"id\":59161,\"author\":\"david\",\"body\":\"that's why we don't export default the store and make it two objects, so we can have all the module imports as \\n\\n`import { \\u003cNAMESPACE\\u003e, module } from ...`\",\"file\":\"app/javascript/packs/store/index.js\",\"line\":22},{\"id\":59162,\"author\":\"david\",\"body\":\"that's why we don't export default the store and make it two objects, so we can have all the module imports as \\n\\n`import { \\u003cNAMESPACE\\u003e, module } from ...`\",\"file\":\"app/javascript/packs/store/index.js\",\"line\":40},{\"id\":59163,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/views/settings/EngagementLetterTemplateDataList.vue\",\"line\":188},{\"id\":59164,\"author\":\"david\",\"body\":\"grouping order is \\n\\n```\\nvendor\\n\\nlocal\\n\\nnamespaces\\n\\ncomponents\\n```\\n\\nhttps://gitlab.innovationlawlab.org/ILL/lawlabplatform/-/wikis/Code-Guidelines#how-to-group-imports\",\"file\":\"app/javascript/packs/views/settings/EngagementLetterTemplateDataListWorking.vue\",\"line\":154},{\"id\":59165,\"author\":\"david\",\"body\":\"shouldn't this import be made in the `setup()` ?\",\"file\":\"app/javascript/packs/views/settings/EngagementLetterTemplateDataListWorking.vue\",\"line\":255},{\"id\":59166,\"author\":\"david\",\"body\":\"can we guarantee that in all the instances, the foreign_key has this name? `fk_rails_1eab6264fb`\",\"file\":\"db/migrate/20250918140933_fix_engagement_letter_template_foreign_key.rb\",\"line\":4},{\"id\":59167,\"author\":\"david\",\"body\":\"I think this is the last wave :grin:\",\"file\":null,\"line\":null}]}"], ["created_at", "2025-11-06 11:49:51.115385"], ["updated_at", "2025-11-06 11:49:51.115385"]]
